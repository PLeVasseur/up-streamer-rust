{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expected Streamer workload replay inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["run", "source_identity", "plan_sha256", "role", "queue_capacity", "pending_limit"],
  "properties": {
    "run": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_identity": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "role": {"enum": ["publisher-subscriber", "client-server-rpc"]},
    "queue_capacity": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "pending_limit": {"type": "integer", "minimum": 1, "maximum": 65536},
    "require_fifo": {"type": "boolean", "default": true}
  }
}
