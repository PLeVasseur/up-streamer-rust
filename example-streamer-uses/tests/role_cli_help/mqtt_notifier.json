"Usage: mqtt_notifier [OPTIONS]\n\nOptions:\n      --uauthority <UAUTHORITY>\n          [default: authority-a]\n      --uentity <UENTITY>\n          [default: 0x15BA0]\n      --uversion <UVERSION>\n          [default: 0x1]\n      --resource <RESOURCE>\n          [default: 0x8001]\n      --sink-authority <SINK_AUTHORITY>\n          [default: authority-b]\n      --sink-uentity <SINK_UENTITY>\n          [default: 0x15BA0]\n      --broker-uri <BROKER_URI>\n          [default: localhost:1883]\n      --send-count <SEND_COUNT>\n          [default: 0]\n      --send-interval-ms <SEND_INTERVAL_MS>\n          [default: 1000]\n      --encoding <ENCODING>\n          [default: protobuf] [possible values: native, protobuf, xcdrv2, arrow, omgidl]\n      --payload <PAYLOAD>\n          [default: mqtt-notifier]\n  -h, --help\n          Print help\n  -V, --version\n          Print version\n"
