"Usage: mqtt_notifyee [OPTIONS]\n\nOptions:\n      --uauthority <UAUTHORITY>              [default: authority-b]\n      --uentity <UENTITY>                    [default: 0x5BA0]\n      --uversion <UVERSION>                  [default: 0x1]\n      --resource <RESOURCE>                  [default: 0x0]\n      --source-authority <SOURCE_AUTHORITY>  [default: authority-a]\n      --source-uentity <SOURCE_UENTITY>      [default: 0x5BA0]\n      --source-uversion <SOURCE_UVERSION>    [default: 0x1]\n      --source-resource <SOURCE_RESOURCE>    [default: 0x8001]\n      --broker-uri <BROKER_URI>              [default: localhost:1883]\n  -h, --help                                 Print help\n  -V, --version                              Print version\n"
