{
  up_streamer_config: {
    message_queue_size: 32,
  },
  streamer_uuri: {
    authority: "authority-streamer",
    ue_id: 78,
    ue_version_major: 1,
  },
  usubscription_config: {
    mode: "static_file",
    file_path: "subscription_data.json",
  },
  transports: {
    zenoh: {
      config_file: "ZENOH_CONFIG.json5",
      endpoints: [
        {
          authority: "authority-a",
          endpoint: "zenoh-zc",
          routing_mode: "copy_minimized",
          prepared_routes: [
            { source: "//authority-b/5BA0/1/0", sink: "//authority-a/5BA0/1/1000", max_payload_len: 8192 },
            { source: "//authority-a/5BA0/1/1000", sink: "//authority-b/5BA0/1/0", max_payload_len: 8192, transmit: false },
          ],
          copy_minimized_payload_alignment: 8,
          forwarding_routes: [
            { endpoint: "lola-zc", wire_format: "up_native" },
          ],
        },
      ],
    },
    mqtt: {
      config_file: "MQTT_CONFIG.json5",
      endpoints: [],
    },
    lola: {
      endpoints: [
        {
          authority: "authority-b",
          endpoint: "lola-zc",
          routing_mode: "copy_minimized",
          prepared_routes: [
            { source: "//authority-b/5BA0/1/0", sink: "//authority-a/5BA0/1/1000", max_payload_len: 8192, transmit: false },
            { source: "//authority-a/5BA0/1/1000", sink: "//authority-b/5BA0/1/0", max_payload_len: 8192 },
          ],
          copy_minimized_payload_alignment: 8,
          lola_instance_specifier: "uprotocol/transportNativeZcRpcSingleL2ZRequest",
          lola_service_type: "/uprotocol/TransportR004D2NativeZcRpcSingleL2ZRequest",
          lola_event_name: "frameNativeZcSingleL2ZRequest",
          lola_response_instance_specifier: "uprotocol/transportNativeZcRpcSingleL2ZResponse",
          lola_response_service_type: "/uprotocol/TransportR004D2NativeZcRpcSingleL2ZResponse",
          lola_response_event_name: "frameNativeZcSingleL2ZResponse",
          lola_default_rx_channel: "primary",
          lola_sample_size: 65536,
          lola_sample_alignment: 8,
          lola_max_samples: 16,
          lola_mw_com_config_file: "MW_COM_CONFIG_LOLA_NATIVE_ZC_RPC_L2Z.json",
          lola_response_mw_com_config_file: "MW_COM_CONFIG_LOLA_NATIVE_ZC_RPC_L2Z.json",
          forwarding_routes: [
            { endpoint: "zenoh-zc", wire_format: "up_native" },
          ],
        },
      ],
    },
  },
}
